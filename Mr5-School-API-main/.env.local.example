# =============================================================================
# MR5 School API — local development overrides
# =============================================================================
# Setup:  cp .env.local.example .env
# macOS: PORT=5001 (5000 = AirPlay). Linux/Windows: PORT=5000 also works.
# =============================================================================

NODE_ENV=development
PORT=5001

# Leave empty for in-memory MongoDB + auto-seed demo users
MONGO_URI=

JWT_SECRET=REPLACE_WITH_DEV_ONLY_SECRET_MIN_32_CHARS
CORS_ORIGIN=http://localhost:3000
CLIENT_URL=http://localhost:3000

GEMINI_API_KEY=
WEATHER_API_KEY=

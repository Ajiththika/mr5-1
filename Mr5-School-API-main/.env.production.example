# =============================================================================
# MR5 School API — production template (AWS Secrets Manager / ECS)
# =============================================================================
# Do NOT commit .env.production with real values.
# Store secrets in AWS Secrets Manager secret: mr5/production/api
# =============================================================================

NODE_ENV=production
PORT=5000
LOG_LEVEL=info

# Required
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/mr5school
JWT_SECRET=

# Frontend URLs (must match deployed web app)
CORS_ORIGIN=https://app.mr5school.com
CLIENT_URL=https://app.mr5school.com
CORS_EXTRA_ORIGINS=

# Auth
JWT_EXPIRE=15m
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_EXPIRES_IN=7d

# AI
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo

# Integrations
WEATHER_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.mr5school.com/api/auth/google/callback
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AVATHOR_SECRET_TOKEN=

# Email
EMAIL_USER=
EMAIL_PASS=
FROM_NAME=MR5 School
FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SUPPORT_EMAIL=

# Legal / consent
LEGAL_RECONSENT_ENFORCED=true
CONSENT_IP_LOGGING=false
CONSENT_IP_SALT=

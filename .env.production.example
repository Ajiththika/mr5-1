# =============================================================================
# MR5 School — monorepo production index (Docker Compose / AWS)
# =============================================================================
# Copy per-service templates and set real values via Secrets Manager in AWS:
#   Mr5-School-API-main/.env.production.example → API secrets
#   client-main/.env.production.example         → Web secrets + build args
# =============================================================================

# Docker Compose root (web runtime secrets)
GEMINI_API_KEY=
WEATHER_API_KEY=

# Docker build args (override in docker compose or CI)
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
